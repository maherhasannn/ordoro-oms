# Ordoro API credentials
# Copy this file to .env and fill in your real credentials.
# Get these from the Ordoro app: Settings → Account Settings → API Keys
#
# These are read in sync.js:
#   const auth = Buffer.from(`${process.env.ORDORO_CLIENT}:${process.env.ORDORO_SECRET}`).toString("base64");
#   headers: { Authorization: `Basic ${auth}` }

ORDORO_CLIENT=
ORDORO_SECRET=
