# Ordoro API credentials
# Get these from: Settings → Account Settings → API Keys
ORDORO_CLIENT=
ORDORO_SECRET=

# Supabase (project settings → API)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Turn14 (dealer portal → API credentials)
TURN14_CLIENT_ID=
TURN14_CLIENT_SECRET=
TURN14_BASE_URL=https://api.turn14.com/v1

# eKeystone FTP (implicit FTPS, port 990)
EKEYSTONE_FTP_HOST=ftp.ekeystone.com
EKEYSTONE_FTP_USER=
EKEYSTONE_FTP_PASS=
EKEYSTONE_FTP_PORT=990

# Meyer API (static key from Meyer rep)
MEYER_API_KEY=
MEYER_CUSTOMER_NUMBER=

# Meyer SFTP (Meyer pushes inventory files to your server)
MEYER_SFTP_HOST=
MEYER_SFTP_PORT=22
MEYER_SFTP_USER=
MEYER_SFTP_PASS=
MEYER_SFTP_DIR=/inbound/inventory

# Email alerts (SMTP — leave blank to log-only, no emails)
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, use an App Password
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
